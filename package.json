{
  "name": "spectraforge",
  "version": "0.1.10",
  "private": true,
  "description": "SpectraForge — laser-materials intelligence app",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/db.ts",
    "db:seed-admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "db:seed-baselines": "node --env-file=.env.local scripts/seed-baselines.mjs",
    "db:seed-machines": "node --env-file=.env.local scripts/seed-machines.mjs",
    "db:seed-recipes": "node --env-file=.env.local scripts/seed-recipes.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "supabase": "^1.223.10",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
