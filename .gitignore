# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — never commit real secrets (BUILD_SPEC §2b). Ignore every .env* except
# the committed templates.
.env
.env.*
!.env.example
!.env.production.example

# supabase local stack
/supabase/.branches
/supabase/.temp

# deploy runtime state (written by the host updater / in-app trigger)
/deploy/state/*
!/deploy/state/.gitkeep

# typescript
*.tsbuildinfo

# vscode
.vscode/*
!.vscode/extensions.json
