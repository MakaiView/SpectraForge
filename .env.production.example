# ─────────────────────────────────────────────────────────────────────────────
# SpectraForge — LXC production env. Copy to `.env.production` on the LXC and
# fill in. NEVER commit the real file (.gitignore covers .env*). Values with
# NEXT_PUBLIC_ are ALSO consumed as Docker build args (see docker-compose.app.yml).
# ─────────────────────────────────────────────────────────────────────────────

# Public Supabase API (Caddy-fronted kong) — inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://sf-api.example.com
# From the Supabase stack .env → ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. From the Supabase stack .env → SERVICE_ROLE_KEY. Never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Migrations target — internal postgres on the sfnet network. PW = Supabase
# stack .env POSTGRES_PASSWORD.
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres

# Reverse proxy (Caddy) — your hostnames + ACME email.
SF_APP_DOMAIN=sf.example.com
SF_API_DOMAIN=sf-api.example.com
SF_ACME_EMAIL=you@example.com

# First admin (one-time seed; registration ships closed). Used by seed-admin.mjs.
SEED_ADMIN_EMAIL=steve@makaiview.dev
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Steve
SEED_ADMIN_COMPANY=Makai View Media

# AI (Ollama Cloud) — OPTIONAL env fallback. Each user can also set provider/
# model/key in Settings → AI & Integrations (server-resolved; preferred).
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
