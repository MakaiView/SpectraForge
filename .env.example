# ─────────────────────────────────────────────────────────────────────────────
# SpectraForge environment. Copy to `.env.local` for dev; set real values on the
# LXC via its own .env (BUILD_SPEC §2b). NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from `supabase start` (local) or your self-hosted stack.
# The URL + anon key are safe in the client bundle; the service role key is
# SERVER-ONLY (used by admin routes + the first-admin seed). Never expose it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# First admin seed (BUILD_SPEC §3b — registration ships closed, so the first
# admin is created outside the sign-up path). Password is set at seed time.
SEED_ADMIN_EMAIL=steve@makaiview.dev
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Steve
SEED_ADMIN_COMPANY=Makai View Media

# AI — Ollama Cloud (BUILD_SPEC §5). Server-only; model is a single config value,
# never hardcoded in logic. Wired in a later phase.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
